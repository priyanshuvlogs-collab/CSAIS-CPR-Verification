# Copy to .env and fill in.
# Claude API key from https://console.anthropic.com (starts with sk-ant-api...)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Password for /admin. Use a long random value.
ADMIN_PASSWORD=change-me
# Signs the admin session cookie. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-too

# Certificates expiring within this many months are flagged "Expiring Soon".
EXPIRY_WARNING_MONTHS=6
# Used to infer expiry when a card only shows an issue date (AHA / Red Cross CPR = 2 years).
DEFAULT_VALIDITY_YEARS=2
MAX_UPLOAD_MB=10

# Local default: SQLite file in DATA_DIR. Uploaded files are stored in the database.
DATA_DIR=data
# Production (e.g. Supabase pooler, transaction mode):
# DATABASE_URL=postgresql+psycopg://USER.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres
# DB_SCHEMA=cpr

# "background" (default) scans after the upload page returns; use "sync" on serverless hosts like Vercel.
SCAN_MODE=background
